`timescale 1ns/1ps

module tb_async_fifo;

    localparam DATA_WIDTH = 8;
    localparam ADDR_WIDTH = 4;
    localparam DEPTH      = (1 << ADDR_WIDTH);

    reg                   wr_clk;
    reg                   wr_rst_n;
    reg                   wr_en;
    reg  [DATA_WIDTH-1:0] wr_data;
    wire                  full;
    wire                  overflow;

    reg                   rd_clk;
    reg                   rd_rst_n;
    reg                   rd_en;
    wire [DATA_WIDTH-1:0] rd_data;
    wire                  empty;
    wire                  underflow;

    async_fifo #(
        .DATA_WIDTH(DATA_WIDTH),
        .ADDR_WIDTH(ADDR_WIDTH)
    ) dut (
        .wr_clk    (wr_clk),
        .wr_rst_n  (wr_rst_n),
        .wr_en     (wr_en),
        .wr_data   (wr_data),
        .full      (full),
        .overflow  (overflow),

        .rd_clk    (rd_clk),
        .rd_rst_n  (rd_rst_n),
        .rd_en     (rd_en),
        .rd_data   (rd_data),
        .empty     (empty),
        .underflow (underflow)
    );

    // Independent clocks: 10 ns write clock and 16 ns read clock.
    initial wr_clk = 1'b0;
    always #5 wr_clk = ~wr_clk;

    initial rd_clk = 1'b0;
    always #8 rd_clk = ~rd_clk;

    byte model_q[$];

    integer directed_pass = 0;
    integer directed_fail = 0;
    integer data_checks   = 0;
    integer data_pass     = 0;
    integer data_fail     = 0;

    integer overflow_events  = 0;
    integer underflow_events = 0;

    integer overflow_event_mismatch  = 0;
    integer underflow_event_mismatch = 0;

    integer i;

    reg                   read_pending;
    reg [DATA_WIDTH-1:0] expected_data;

    task automatic check(
        input cond,
        input [8*100-1:0] msg
    );
        begin
            if (cond) begin
                directed_pass = directed_pass + 1;
                $display("[PASS] %0t : %s", $time, msg);
            end else begin
                directed_fail = directed_fail + 1;
                $display("[FAIL] %0t : %s", $time, msg);
            end
        end
    endtask

    // Scoreboard tracks only accepted writes.
    always @(posedge wr_clk) begin
        if (wr_en && !full && dut.wr_fifo_enable)
            model_q.push_back(wr_data);
    end

    initial begin
        read_pending  = 1'b0;
        expected_data = '0;
    end

    // rd_data is registered, so compare one read clock after an accepted read.
    always @(posedge rd_clk) begin
        if (read_pending) begin
            data_checks = data_checks + 1;

            if (rd_data === expected_data)
                data_pass = data_pass + 1;
            else begin
                data_fail = data_fail + 1;
                $display("[DATA FAIL] %0t : expected=0x%0h got=0x%0h",
                         $time, expected_data, rd_data);
            end
        end

        if (rd_en && !empty && dut.rd_fifo_enable) begin
            if (model_q.size() == 0) begin
                data_fail = data_fail + 1;
                $display("[SCOREBOARD FAIL] %0t : DUT accepted a read but model is empty",
                         $time);
                read_pending  <= 1'b0;
                expected_data <= '0;
            end else begin
                read_pending  <= 1'b1;
                expected_data <= model_q.pop_front();
            end
        end else begin
            read_pending <= 1'b0;
        end
    end

    always @(posedge wr_clk)
        if (overflow)
            overflow_events = overflow_events + 1;

    always @(posedge rd_clk)
        if (underflow)
            underflow_events = underflow_events + 1;

    reg overflow_model;
    reg underflow_model;

    initial begin
        overflow_model  = 1'b0;
        underflow_model = 1'b0;
    end

    // Shadow models mirror the DUT event-generation priority.
    always @(posedge wr_clk or negedge wr_rst_n) begin
        if (!wr_rst_n)
            overflow_model <= 1'b0;
        else if (!dut.wr_fifo_enable)
            overflow_model <= 1'b0;
        else
            overflow_model <= wr_en && full;
    end

    always @(posedge rd_clk or negedge rd_rst_n) begin
        if (!rd_rst_n)
            underflow_model <= 1'b0;
        else if (!dut.rd_fifo_enable)
            underflow_model <= 1'b0;
        else
            underflow_model <= rd_en && empty;
    end

    // Check on the opposite clock edge to avoid same-edge race conditions.
    always @(negedge wr_clk) begin
        if ($time > 0 && (overflow !== overflow_model)) begin
            overflow_event_mismatch = overflow_event_mismatch + 1;
            $display("[EVENT FAIL] %0t : overflow=%b expected=%b",
                     $time, overflow, overflow_model);
        end
    end

    always @(negedge rd_clk) begin
        if ($time > 0 && (underflow !== underflow_model)) begin
            underflow_event_mismatch = underflow_event_mismatch + 1;
            $display("[EVENT FAIL] %0t : underflow=%b expected=%b",
                     $time, underflow, underflow_model);
        end
    end

    task automatic do_write(input [DATA_WIDTH-1:0] data);
        begin
            @(negedge wr_clk);
            wr_en   <= 1'b1;
            wr_data <= data;
            @(negedge wr_clk);
            wr_en   <= 1'b0;
        end
    endtask

    task automatic do_read;
        begin
            @(negedge rd_clk);
            rd_en <= 1'b1;
            @(negedge rd_clk);
            rd_en <= 1'b0;
        end
    endtask

    task automatic hold_write(
        input [DATA_WIDTH-1:0] data,
        input integer cycles
    );
        integer k;
        begin
            @(negedge wr_clk);
            wr_en   <= 1'b1;
            wr_data <= data;
            for (k = 0; k < cycles; k = k + 1)
                @(negedge wr_clk);
            wr_en <= 1'b0;
        end
    endtask

    task automatic hold_read(input integer cycles);
        integer k;
        begin
            @(negedge rd_clk);
            rd_en <= 1'b1;
            for (k = 0; k < cycles; k = k + 1)
                @(negedge rd_clk);
            rd_en <= 1'b0;
        end
    endtask

    task automatic wait_wr_ready;
        begin
            wait (dut.wr_fifo_enable === 1'b1);
        end
    endtask

    task automatic wait_rd_ready;
        begin
            wait (dut.rd_fifo_enable === 1'b1);
        end
    endtask

    task automatic wait_both_ready;
        begin
            wait_wr_ready;
            wait_rd_ready;
        end
    endtask

    task automatic settle_both;
        begin
            repeat (4) @(posedge wr_clk);
            repeat (4) @(posedge rd_clk);
        end
    endtask

    task automatic reset_both_simultaneous;
        begin
            wr_en    = 1'b0;
            rd_en    = 1'b0;
            wr_data  = '0;
            wr_rst_n = 1'b0;
            rd_rst_n = 1'b0;

            repeat (5) @(posedge wr_clk);

            wr_rst_n = 1'b1;
            rd_rst_n = 1'b1;

            wait_both_ready;
            settle_both;
        end
    endtask

    task automatic reset_both_skewed;
        begin
            wr_en    = 1'b0;
            rd_en    = 1'b0;
            wr_rst_n = 1'b0;
            rd_rst_n = 1'b0;

            repeat (3) @(posedge wr_clk);
            wr_rst_n = 1'b1;

            repeat (7) @(posedge rd_clk);
            rd_rst_n = 1'b1;

            wait_both_ready;
            settle_both;
        end
    endtask

    task automatic drain_read_pipeline;
        begin
            rd_en = 1'b0;
            repeat (3) @(posedge rd_clk);
            read_pending = 1'b0;
        end
    endtask

    task automatic clear_model;
        begin
            drain_read_pipeline;
            model_q.delete();
        end
    endtask

    task automatic post_reset_settle;
        begin
            wait_both_ready;
            repeat (4) @(posedge wr_clk);
            repeat (4) @(posedge rd_clk);

            check(dut.wr_ptr_bin === {ADDR_WIDTH+1{1'b0}},
                  "post-reset: write binary pointer is zero");
            check(dut.rd_ptr_bin === {ADDR_WIDTH+1{1'b0}},
                  "post-reset: read binary pointer is zero");
            check(dut.wr_ptr_gray === {ADDR_WIDTH+1{1'b0}},
                  "post-reset: write Gray pointer is zero");
            check(dut.rd_ptr_gray === {ADDR_WIDTH+1{1'b0}},
                  "post-reset: read Gray pointer is zero");
            check(dut.rd_ptr_gray_sync === {ADDR_WIDTH+1{1'b0}},
                  "post-reset: synchronized read Gray pointer is zero");
            check(dut.wr_ptr_gray_sync === {ADDR_WIDTH+1{1'b0}},
                  "post-reset: synchronized write Gray pointer is zero");
        end
    endtask

    reg [DATA_WIDTH-1:0] pattern;

    initial begin
        wr_en    = 1'b0;
        rd_en    = 1'b0;
        wr_data  = '0;
        wr_rst_n = 1'b0;
        rd_rst_n = 1'b0;

        $display("\n================================================");
        $display("TEST 1: simultaneous reset / initialization");
        $display("================================================");
        reset_both_simultaneous;
        check(empty === 1'b1, "after reset: empty=1");
        check(full  === 1'b0, "after reset: full=0");
        check(dut.wr_fifo_enable === 1'b1, "write FIFO enable recovered");
        check(dut.rd_fifo_enable === 1'b1, "read FIFO enable recovered");
        check(dut.wr_ptr_bin === 0, "write pointer reset to zero");
        check(dut.rd_ptr_bin === 0, "read pointer reset to zero");
        check(model_q.size() == 0, "scoreboard empty after reset");

        $display("\n================================================");
        $display("TEST 2: single write / single read");
        $display("================================================");
        do_write(8'hA5);
        settle_both;
        do_read;
        repeat (2) @(posedge rd_clk);
        check(data_fail == 0, "single write/read data matched");
        check(empty === 1'b1, "FIFO empty after single read");

        $display("\n================================================");
        $display("TEST 3: fill FIFO to full with reader stopped");
        $display("================================================");
        clear_model;
        settle_both;
        rd_en = 1'b0;

        for (i = 0; i < DEPTH; i = i + 1) begin
            pattern = 8'h40 + i[7:0];
            do_write(pattern);
        end

        repeat (3) @(posedge wr_clk);
        check(full === 1'b1, "FIFO reports full after DEPTH writes");
        check(model_q.size() == DEPTH,
              "scoreboard contains exactly DEPTH entries");

        $display("\n================================================");
        $display("TEST 4: DEPTH+1 write / overflow");
        $display("================================================");
        overflow_events = 0;
        do_write(8'hEE);
        repeat (2) @(posedge wr_clk);
        check(full === 1'b1, "FIFO remains full after rejected write");
        check(overflow_events == 1,
              "exactly one overflow pulse for one rejected write");
        check(model_q.size() == DEPTH,
              "rejected write did not enter scoreboard");

        $display("\n================================================");
        $display("TEST 5: drain FIFO / empty");
        $display("================================================");
        for (i = 0; i < DEPTH; i = i + 1)
            do_read;

        repeat (4) @(posedge rd_clk);
        check(empty === 1'b1, "FIFO reports empty after drain");
        check(model_q.size() == 0, "scoreboard empty after drain");
        check(data_fail == 0, "all full-FIFO data matched");

        $display("\n================================================");
        $display("TEST 6: DEPTH+1 read / underflow");
        $display("================================================");
        underflow_events = 0;
        do_read;
        repeat (2) @(posedge rd_clk);
        check(empty === 1'b1, "FIFO remains empty after rejected read");
        check(underflow_events == 1,
              "exactly one underflow pulse for one rejected read");

        $display("\n================================================");
        $display("TEST 7: normal burst with reader stopped");
        $display("================================================");
        clear_model;
        settle_both;

        for (i = 0; i < 8; i = i + 1)
            do_write(8'h10 + i[7:0]);

        settle_both;
        check(full === 1'b0, "half-filled FIFO is not full");
        check(empty === 1'b0, "FIFO is not empty after writes");

        for (i = 0; i < 8; i = i + 1)
            do_read;

        repeat (4) @(posedge rd_clk);
        check(empty === 1'b1, "FIFO empty after burst drain");
        check(data_fail == 0, "burst data integrity passed");

        $display("\n================================================");
        $display("TEST 8: pointer wraparound");
        $display("================================================");
        clear_model;
        settle_both;

        for (i = 0; i < 3; i = i + 1) begin : WRAP_ROUND
            integer j;

            for (j = 0; j < DEPTH; j = j + 1)
                do_write((i * DEPTH + j) * 7 + 3);

            settle_both;

            for (j = 0; j < DEPTH; j = j + 1)
                do_read;

            drain_read_pipeline;
            settle_both;
        end

        check(data_fail == 0, "wraparound data integrity passed");
        check(model_q.size() == 0, "scoreboard empty after wraparound");
        check(empty === 1'b1, "FIFO empty after equal wraparound traffic");

        $display("\n================================================");
        $display("TEST 9: writer faster / reader stopped");
        $display("================================================");
        clear_model;
        settle_both;
        rd_en = 1'b0;

        for (i = 0; i < DEPTH; i = i + 1)
            do_write(8'h80 + i[7:0]);

        repeat (3) @(posedge wr_clk);
        check(full === 1'b1, "full reached with reader stopped");

        overflow_events = 0;
        for (i = 0; i < 3; i = i + 1)
            do_write(8'hF1);

        repeat (2) @(posedge wr_clk);
        check(overflow_events == 3,
              "three rejected writes generated three overflow pulses");
        check(model_q.size() == DEPTH,
              "no rejected writes entered scoreboard");

        for (i = 0; i < DEPTH; i = i + 1)
            do_read;

        repeat (4) @(posedge rd_clk);
        check(data_fail == 0, "writer-only phase data integrity passed");
        check(empty === 1'b1, "FIFO empty after writer-only phase drain");

        $display("\n================================================");
        $display("TEST 10: reader faster / writer stopped");
        $display("================================================");
        clear_model;
        settle_both;

        for (i = 0; i < 5; i = i + 1)
            do_write(8'hC0 + i[7:0]);

        settle_both;

        for (i = 0; i < 5; i = i + 1)
            do_read;

        repeat (3) @(posedge rd_clk);
        check(empty === 1'b1, "FIFO empty after reader drains all data");

        underflow_events = 0;
        for (i = 0; i < 3; i = i + 1)
            do_read;

        repeat (2) @(posedge rd_clk);
        check(underflow_events == 3,
              "three rejected reads generated three underflow pulses");
        check(data_fail == 0, "reader-only phase data integrity passed");

        $display("\n================================================");
        $display("TEST 11: independent write reset at half-full");
        $display("================================================");
        clear_model;
        settle_both;

        for (i = 0; i < 8; i = i + 1)
            do_write(8'h20 + i[7:0]);

        settle_both;

        wr_rst_n = 1'b0;
        repeat (4) @(posedge wr_clk);
        repeat (4) @(posedge rd_clk);
        check(dut.wr_fifo_enable === 1'b0,
              "write FIFO enable drops during write reset");

        repeat (4) @(posedge rd_clk);
        check(dut.rd_fifo_enable === 1'b0,
              "read FIFO enable drops after write reset propagates");

        wr_rst_n = 1'b1;
        post_reset_settle;
        clear_model;

        check(empty === 1'b1, "FIFO logically flushed after write-only reset");
        check(full === 1'b0, "FIFO not full after write-only reset");

        do_write(8'h33);
        settle_both;
        do_read;
        drain_read_pipeline;
        check(data_fail == 0, "FIFO works after write-only reset recovery");

        $display("\n================================================");
        $display("TEST 12: independent read reset at half-full");
        $display("================================================");
        clear_model;
        settle_both;

        for (i = 0; i < 8; i = i + 1)
            do_write(8'h30 + i[7:0]);

        settle_both;

        rd_rst_n = 1'b0;
        repeat (4) @(posedge rd_clk);
        repeat (4) @(posedge wr_clk);
        check(dut.rd_fifo_enable === 1'b0,
              "read FIFO enable drops during read reset");

        repeat (4) @(posedge wr_clk);
        check(dut.wr_fifo_enable === 1'b0,
              "write FIFO enable drops after read reset propagates");

        rd_rst_n = 1'b1;
        post_reset_settle;
        clear_model;

        check(empty === 1'b1, "FIFO logically flushed after read-only reset");
        check(full === 1'b0, "FIFO not full after read-only reset");

        do_write(8'h66);
        settle_both;
        do_read;
        drain_read_pipeline;
        check(data_fail == 0, "FIFO works after read-only reset recovery");

        $display("\n================================================");
        $display("TEST 13: reset while FIFO is full");
        $display("================================================");
        clear_model;
        settle_both;

        for (i = 0; i < DEPTH; i = i + 1)
            do_write(8'h50 + i[7:0]);

        repeat (3) @(posedge wr_clk);
        check(full === 1'b1, "FIFO full before reset");

        wr_rst_n = 1'b0;
        repeat (5) @(posedge wr_clk);
        check(full === 1'b0, "full clears during write reset");

        repeat (4) @(posedge rd_clk);
        check(dut.rd_fifo_enable === 1'b0,
              "read side stops after full-FIFO write reset");

        wr_rst_n = 1'b1;
        post_reset_settle;
        clear_model;

        check(empty === 1'b1, "full FIFO is logically flushed by reset");
        check(full === 1'b0, "full clears after recovery");

        $display("\n================================================");
        $display("TEST 14: reset while enables are active");
        $display("================================================");
        clear_model;
        settle_both;

        fork
            begin
                hold_write(8'hAB, 8);
            end

            begin
                hold_read(8);
            end

            begin
                #37;
                wr_rst_n = 1'b0;
                rd_rst_n = 1'b0;
                #23;
                wr_rst_n = 1'b1;
                rd_rst_n = 1'b1;
            end
        join

        wait_both_ready;
        settle_both;
        clear_model;

        check(empty === 1'b1, "FIFO empty after reset during active traffic");
        check(full === 1'b0, "FIFO not full after reset during active traffic");

        $display("\n================================================");
        $display("TEST 15: skewed reset release");
        $display("================================================");
        clear_model;
        reset_both_skewed;

        check(dut.wr_fifo_enable === 1'b1,
              "write FIFO enable recovered after skewed reset");
        check(dut.rd_fifo_enable === 1'b1,
              "read FIFO enable recovered after skewed reset");
        check(empty === 1'b1, "FIFO empty after skewed reset");

        do_write(8'h77);
        settle_both;
        do_read;
        drain_read_pipeline;
        check(data_fail == 0, "FIFO works after skewed reset release");

        $display("\n================================================");
        $display("TEST 16: reset with data in flight");
        $display("================================================");
        clear_model;
        settle_both;

        for (i = 0; i < 5; i = i + 1)
            do_write(8'h90 + i[7:0]);

        settle_both;

        fork
            begin
                for (i = 0; i < 3; i = i + 1)
                    do_read;
            end

            begin
                #19;
                wr_rst_n = 1'b0;
                rd_rst_n = 1'b0;
                #27;
                wr_rst_n = 1'b1;
                rd_rst_n = 1'b1;
            end
        join

        wait_both_ready;
        settle_both;
        clear_model;

        check(empty === 1'b1, "FIFO empty after mid-operation reset");
        check(full === 1'b0, "FIFO not full after mid-operation reset");

        do_write(8'h99);
        settle_both;
        do_read;
        drain_read_pipeline;
        check(data_fail == 0, "FIFO works after mid-operation reset");

        $display("\n================================================");
        $display("TEST 17: concurrent random stress");
        $display("================================================");
        clear_model;
        settle_both;

        fork
            begin : wr_stress
                integer k;

                for (k = 0; k < 600; k = k + 1) begin
                    @(negedge wr_clk);

                    if ($urandom_range(0,1)) begin
                        wr_en   <= 1'b1;
                        wr_data <= $urandom_range(0,255);
                    end else begin
                        wr_en <= 1'b0;
                    end
                end

                wr_en <= 1'b0;
            end

            begin : rd_stress
                integer k;

                for (k = 0; k < 600; k = k + 1) begin
                    @(negedge rd_clk);
                    rd_en <= $urandom_range(0,1);
                end

                rd_en <= 1'b0;
            end
        join

        wr_en = 1'b0;
        rd_en = 1'b0;
        settle_both;

        while (model_q.size() > 0) begin
            if (dut.rd_fifo_enable && !empty)
                do_read;
            else
                @(posedge rd_clk);
        end

        drain_read_pipeline;
        settle_both;

        check(data_fail == 0, "random stress: zero data mismatches");
        check(model_q.size() == 0, "random stress: scoreboard fully drained");

        $display("\n================================================");
        $display("TEST 18: overflow/underflow event summary");
        $display("================================================");

        check(overflow_event_mismatch == 0,
              "overflow event matches every rejected write");
        check(underflow_event_mismatch == 0,
              "underflow event matches every rejected read");

        wr_en = 1'b0;
        rd_en = 1'b0;

        repeat (3) @(posedge wr_clk);
        repeat (3) @(posedge rd_clk);
        settle_both;

        $display("\n================================================");
        $display("FINAL RESULTS");
        $display("================================================");

        $display("Directed checks : %0d passed / %0d failed / %0d total",
                 directed_pass,
                 directed_fail,
                 directed_pass + directed_fail);

        $display("Data integrity  : %0d passed / %0d failed / %0d total",
                 data_pass,
                 data_fail,
                 data_checks);

        $display("Overflow pulses : %0d", overflow_events);
        $display("Underflow pulses: %0d", underflow_events);

        $display("Overflow event mismatches : %0d",
                 overflow_event_mismatch);
        $display("Underflow event mismatches: %0d",
                 underflow_event_mismatch);

        if ((directed_fail == 0) &&
            (data_fail == 0) &&
            (overflow_event_mismatch == 0) &&
            (underflow_event_mismatch == 0)) begin

            $display("RESULT: ALL CHECKS PASSED (%0d/%0d)",
                     directed_pass + data_pass,
                     directed_pass + directed_fail + data_checks);
        end else begin

            $display("RESULT: FAILURES PRESENT - %0d/%0d checks failed",
                     directed_fail +
                     data_fail +
                     overflow_event_mismatch +
                     underflow_event_mismatch,

                     directed_pass +
                     directed_fail +
                     data_checks +
                     overflow_event_mismatch +
                     underflow_event_mismatch);
        end

        $display("================================================");

        $finish;
    end

    // Prevent a deadlocked simulation from running indefinitely.
    initial begin
        #300000;
        $display("[TIMEOUT] Testbench did not finish. Check for a deadlock/hang.");
        $finish;
    end

endmodule
