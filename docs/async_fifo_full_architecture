<line x1="350" y1="170" x2="350" y2="230" stroke="#5F5E5A" stroke-width="1.3" marker-end="url(#arrow)"/>
<line x1="1400" y1="170" x2="1400" y2="230" stroke="#5F5E5A" stroke-width="1.3" marker-end="url(#arrow)"/>

<!-- ===================== BOX: u_wr_handshake ===================== -->
<rect x="140" y="230" width="420" height="120" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="1"/>
<text x="350" y="250" text-anchor="middle" font-size="13" font-weight="700" fill="#2C2C2A">u_wr_handshake</text>
<text x="350" y="266" text-anchor="middle" font-size="10" fill="#5F5E5A">(reset_handshake)</text>
<text x="160" y="284" font-size="11" fill="#2C2C2A">in:  clk = wr_clk, rst_n = wr_local_rst_n,</text>
<text x="160" y="299" font-size="11" fill="#2C2C2A">     remote_init_done = rd_init_done,</text>
<text x="160" y="314" font-size="11" fill="#2C2C2A">     remote_ready = rd_ready</text>
<text x="160" y="332" font-size="11" fill="#2C2C2A">out: init_done=wr_init_done, ready=wr_ready,</text>
<text x="160" y="347" font-size="11" fill="#2C2C2A">     remote_ready_sync=wr_remote_ready_sync</text>

<!-- ===================== BOX: u_rd_handshake ===================== -->
<rect x="1190" y="230" width="420" height="120" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="1"/>
<text x="1400" y="250" text-anchor="middle" font-size="13" font-weight="700" fill="#2C2C2A">u_rd_handshake</text>
<text x="1400" y="266" text-anchor="middle" font-size="10" fill="#5F5E5A">(reset_handshake)</text>
<text x="1210" y="284" font-size="11" fill="#2C2C2A">in:  clk = rd_clk, rst_n = rd_local_rst_n,</text>
<text x="1210" y="299" font-size="11" fill="#2C2C2A">     remote_init_done = wr_init_done,</text>
<text x="1210" y="314" font-size="11" fill="#2C2C2A">     remote_ready = wr_ready</text>
<text x="1210" y="332" font-size="11" fill="#2C2C2A">out: init_done=rd_init_done, ready=rd_ready,</text>
<text x="1210" y="347" font-size="11" fill="#2C2C2A">     remote_ready_sync=rd_remote_ready_sync</text>

