<!-- ===================== BOX: u_wr_reset_sync ===================== -->
<rect x="140" y="90" width="420" height="80" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="1"/>
<text x="350" y="110" text-anchor="middle" font-size="13" font-weight="700" fill="#2C2C2A">u_wr_reset_sync</text>
<text x="350" y="126" text-anchor="middle" font-size="10" fill="#5F5E5A">(reset_sync)</text>
<text x="160" y="144" font-size="11" fill="#2C2C2A">in:  clk = wr_clk,  arst_n = wr_rst_n</text>
<text x="160" y="160" font-size="11" fill="#2C2C2A">out: srst_n = wr_local_rst_n</text>

<!-- ===================== BOX: u_rd_reset_sync ===================== -->
<rect x="1190" y="90" width="420" height="80" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="1"/>
<text x="1400" y="110" text-anchor="middle" font-size="13" font-weight="700" fill="#2C2C2A">u_rd_reset_sync</text>
<text x="1400" y="126" text-anchor="middle" font-size="10" fill="#5F5E5A">(reset_sync)</text>
<text x="1210" y="144" font-size="11" fill="#2C2C2A">in:  clk = rd_clk,  arst_n = rd_rst_n</text>
<text x="1210" y="160" font-size="11" fill="#2C2C2A">out: srst_n = rd_local_rst_n</text>

